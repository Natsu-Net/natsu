{
	"name": "natsu",
	"version": "2.0.0-alpha.1",
	"description": "natsu web framework \u2014 Bun core (v2). Zero runtime dependencies; the devDependencies exist only to typecheck.",
	"private": true,
	"type": "module",
	"module": "index.ts",
	"main": "index.ts",
	"types": "index.ts",
	"scripts": {
		"test": "bun test",
		"test:e2e": "bun test ./tests/navigate.e2e.ts",
		"bench": "bun run bench/bench.ts",
		"dev": "bun run --watch example/app.ts",
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"happy-dom": "^20.14.5",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"uwu-template": "file:../../uwu-template/packages/uwu"
	},
	"overrides": {
		"@uwu/assets": "file:../../uwu-template/packages/assets",
		"@uwu/compiler": "file:../../uwu-template/packages/compiler",
		"@uwu/runtime": "file:../../uwu-template/packages/runtime",
		"@uwu/runtime-client": "file:../../uwu-template/packages/runtime-client",
		"@uwu/store": "file:../../uwu-template/packages/store"
	}
}
